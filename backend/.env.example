# Application
APP_ENV=development
APP_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite default for instant local dev; PostgreSQL for Docker/Prod)
DATABASE_URL=sqlite:///./parkvektor_local.db
# DATABASE_URL=postgresql+psycopg://parkvektor:parkvektor@postgres:5432/parkvektor

# Object Storage (local filesystem for dev; s3 for MinIO / Frankfurt S3 / Hetzner S3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./local_storage
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=eu-central-1
S3_BUCKET=parkvektor-evidence-de
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Payments (mock for zero-key local testing; stripe for test/live Stripe)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Security
ADMIN_API_KEY=dev-admin-key-change-in-prod
DEFAULT_EDGE_HMAC_SECRET=dev-lane-secret-change-in-prod
AUTO_SEED_DEMO_DATA=true
